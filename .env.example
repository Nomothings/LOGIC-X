# LOGIC-X environment configuration
# Copy to .env and fill in your endpoint credentials.

# --- LLM API endpoints (OpenAI-compatible) --------------------------------
# The client pools every API_<i>_* group defined below and routes requests
# to the endpoint with the most free slots. Add more groups as needed
# (API_2_*, API_3_*, ...). Only API_1_* is required.
API_1_BASE=https://api.example.com/v1
API_1_KEY=sk-your-api-key
API_1_MODEL=qwen3-8b
API_1_WORKER_NUM=16

# --- Generation defaults ---------------------------------------------------
MAX_TOKENS=8192
TEMPERATURE=0.6
TIMEOUT=120.0

# --- Tool binaries (optional overrides) -------------------------------------
# Directory containing prover9/ and minizinc/ installations.
# z3 is resolved from PATH or the Python environment.
# TMCTS_TOOLS_BIN=/opt/tools_bin

# --- T-MCTS tree search (trajectory generation, --search tree) ---------------
# Reward weights (Eq. 10): R_T = clip01(w_ans*R_ans + w_exec*R_exec
#                                   - b_switch*n_switch - b_repair*n_repair)
TMCTS_LAMBDA_ANS=0.8
TMCTS_LAMBDA_EXEC=0.2
TMCTS_BETA_SWITCH=0.05
TMCTS_BETA_REPAIR=0.05
# UCB exploration coefficient (Eq. 1)
TMCTS_C=1.0
# Candidates sampled per expansion
TMCTS_EXPANSION_K=3
# Search budget per problem
TMCTS_RUNS_PER_CASE=3
TMCTS_MAX_ROLLOUTS=16
TMCTS_MAX_DEPTH=6
# Temperature for candidate sampling (rollouts use the global TEMPERATURE)
TMCTS_CAND_TEMP=0.9
